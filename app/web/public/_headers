# Response headers for the public site (Workers static assets read this file; Vite copies public/ into dist/).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# Vite names every file under /assets/ after a hash of its content, so a given file never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The documents are rebuilt hourly and the UI checks /api/health.json every 2 minutes.
/api/*
  Cache-Control: public, max-age=120
