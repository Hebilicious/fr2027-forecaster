{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The account comes from CLOUDFLARE_ACCOUNT_ID (set in CI), never from this file.
  "name": "fr2027",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "send_metrics": false,
  // The public site: what `moon run cli:export` writes to .site/ at the repository root.
  // Only /inbox/* and /api/* run the Worker script: /api/* so that a missing document answers 404
  // rather than the single-page fallback. Every other request is served from the assets.
  "assets": {
    "directory": "../../.site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/inbox/*", "/api/*"],
  },
  // The inbox lives in one SQLite-backed Durable Object instance (see src/index.ts).
  // INBOX_BOT_TOKEN and INBOX_PIPELINE_TOKEN are secrets, set with `wrangler secret put`.
  // They are deliberately not listed under `secrets.required`: that would make `wrangler deploy`
  // fail until both exist, and the site must deploy without them (the inbox then answers 503).
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "Inbox" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }],
  // GitHub does not reliably fire the Live workflow's hourly `schedule`, so this cron starts it
  // with a repository_dispatch (src/dispatch.ts). It signs in as the GitHub App `heb-release`
  // with the secret GITHUB_APP_PRIVATE_KEY, also left out of `secrets.required`: without it the
  // cron logs a warning and does nothing. The client ID is public.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "GITHUB_REPOSITORY": "Hebilicious/fr2027-forecaster",
    "GITHUB_APP_CLIENT_ID": "Iv23lierXRciGQXCgOuJ",
  },
}
